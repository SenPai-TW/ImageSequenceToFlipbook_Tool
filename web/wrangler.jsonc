{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "image-sequence-to-flipbook",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/runtime/ffmpeg/*"]
  },
  // R2 is intentionally disabled for the first free deployment. The FFmpeg
  // runtime route and browser video implementation remain in the codebase.
  // Re-enable the binding below after R2 has been activated and populated:
  // "r2_buckets": [
  //   {
  //     "binding": "FFMPEG_RUNTIME",
  //     "bucket_name": "flipbook-ffmpeg-runtime"
  //   }
  // ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "logs": {
      "invocation_logs": true
    }
  }
}
